// ============================================================
// Slay the Spire Demo - SongLang
// A card battle system where RELATIONSHIPS define behavior
// ============================================================
//
// In OOP:  player.PlayCard(card, enemy)
// In Song: Player PlayCard SlimeM Strike
//
// The behavior belongs to the RELATIONSHIP, not the object.
// This is the core philosophy of SongLang.
// ============================================================

// ============================================================
// Part 1: Core Entities
// ============================================================

// --- Player ---
Player IS Entity
Player HAS HP 80
Player HAS MaxHP 80
Player HAS Block 0
Player HAS Energy 3
Player HAS MaxEnergy 3
Player HAS Name "Ironclad"

// --- Enemies ---
SlimeM IS Entity
SlimeM HAS HP 29
SlimeM HAS MaxHP 29
SlimeM HAS Block 0
SlimeM HAS Damage 8
SlimeM HAS Name "Spike Slime (M)"

SlimeS IS Entity
SlimeS HAS HP 12
SlimeS HAS MaxHP 12
SlimeS HAS Block 0
SlimeS HAS Damage 5
SlimeS HAS Name "Acid Slime (S)"

// --- Cards ---
// Note: Card is both a type node AND a role name in PlayCard.
// This works correctly because role bindings take priority
// over graph nodes in WHEN expression contexts.
Strike IS Card
Strike HAS Name "Strike"
Strike HAS Cost 1
Strike HAS DamageVal 6
Strike HAS BlockVal 0
Strike HAS Type "Attack"

Defend IS Card
Defend HAS Name "Defend"
Defend HAS Cost 1
Defend HAS DamageVal 0
Defend HAS BlockVal 5
Defend HAS Type "Skill"

Bash IS Card
Bash HAS Name "Bash"
Bash HAS Cost 2
Bash HAS DamageVal 8
Bash HAS BlockVal 0
Bash HAS Type "Attack"

// ============================================================
// Part 2: Relations = Behavior
// ============================================================

// --- Deal Damage: Block absorbs first, then HP ---
DealDamage IS RELATION (Src, Victim, Dmg)
DealDamage DO
    Victim WHEN (Victim.Block >= Dmg.Value AND Dmg.Value > 0) DO
        Victim HAS Block (Victim.Block - Dmg.Value)
        Dmg HAS Value 0
    END
    Victim WHEN (Victim.Block > 0 AND Victim.Block < Dmg.Value) DO
        Dmg HAS Value (Dmg.Value - Victim.Block)
        Victim HAS Block 0
    END
    Victim WHEN (Dmg.Value > 0) DO
        Victim HAS HP (Victim.HP - Dmg.Value)
    END
END

// --- Gain Block ---
GainBlock IS RELATION (Target, Amount)
GainBlock DO
    Target HAS Block (Target.Block + Amount.Value)
END

// --- Play a Card: the CORE relation ---
// "Player PlayCard SlimeM Strike" reads like a game design doc!
PlayCard IS RELATION (Caster, Target, Card)
PlayCard DO
    Caster HAS Energy (Caster.Energy - Card.Cost)

    Card WHEN (Card.Type == "Attack") DO
        DmgNode HAS Value (Card.DamageVal)
        Caster DealDamage Target DmgNode
    END

    Card WHEN (Card.Type == "Skill") DO
        BlkNode HAS Value (Card.BlockVal)
        Caster GainBlock BlkNode
    END
END

// --- Start Turn: reset block, restore energy ---
StartTurn IS RELATION (Who)
StartTurn DO
    Who HAS Block 0
    Who HAS Energy (Who.MaxEnergy)
END

// --- Enemy Attack ---
EnemyAct IS RELATION (Mob, Target)
EnemyAct DO
    EnemyDmg HAS Value (Mob.Damage)
    Mob DealDamage Target EnemyDmg
END

// --- Check Death ---
CheckDeath IS RELATION (Target)
CheckDeath DO
    Target WHEN (Target.HP <= 0) DO
        Target IS Dead
        ("  ** " + Target.Name + " has been defeated! **") PRINT
    END
END

// --- Status Display ---
ShowHP IS RELATION (Who)
ShowHP DO
    ("  " + Who.Name + " | HP: " + Who.HP + " | Block: " + Who.Block) PRINT
END

// ============================================================
// Part 3: Battle Simulation
// ============================================================

("========================================") PRINT
("  SLAY THE SPIRE - SongLang Demo") PRINT
("========================================") PRINT
("") PRINT
("--- Battle Start ---") PRINT
Player ShowHP
SlimeM ShowHP
SlimeS ShowHP
("") PRINT

// ============================================================
// Turn 1: Player
// ============================================================
("=== TURN 1: Player ===") PRINT
("  Energy: " + Player.Energy + "/" + Player.MaxEnergy) PRINT
("") PRINT

// Play Strike -> Spike Slime
(">> Play Strike -> Spike Slime (M)") PRINT
Player PlayCard SlimeM Strike
SlimeM ShowHP
("  Energy: " + Player.Energy) PRINT
("") PRINT

// Play Strike -> Spike Slime again
(">> Play Strike -> Spike Slime (M)") PRINT
Player PlayCard SlimeM Strike
SlimeM ShowHP
("  Energy: " + Player.Energy) PRINT
("") PRINT

// Play Defend (target = self)
(">> Play Defend") PRINT
Player PlayCard Player Defend
Player ShowHP
("  Energy: " + Player.Energy) PRINT
("") PRINT

// ============================================================
// Turn 1: Enemies
// ============================================================
("=== TURN 1: Enemies ===") PRINT
("") PRINT

(">> Spike Slime (M) attacks!") PRINT
SlimeM EnemyAct Player
Player ShowHP
("") PRINT

(">> Acid Slime (S) attacks!") PRINT
SlimeS EnemyAct Player
Player ShowHP
("") PRINT

// ============================================================
// Turn 2: Player
// ============================================================
Player StartTurn
("=== TURN 2: Player ===") PRINT
("  Energy: " + Player.Energy + "/" + Player.MaxEnergy) PRINT
("  Player HP: " + Player.HP) PRINT
("") PRINT

// Play Bash -> Spike Slime (heavy hit, cost 2)
(">> Play Bash -> Spike Slime (M)  [Cost 2, Dmg 8]") PRINT
Player PlayCard SlimeM Bash
SlimeM ShowHP
SlimeM CheckDeath
("  Energy: " + Player.Energy) PRINT
("") PRINT

// Play Strike -> Acid Slime
(">> Play Strike -> Acid Slime (S)") PRINT
Player PlayCard SlimeS Strike
SlimeS ShowHP
SlimeS CheckDeath
("  Energy: " + Player.Energy) PRINT
("") PRINT

// ============================================================
// Turn 2: Enemies (survivors attack)
// ============================================================
("=== TURN 2: Enemies ===") PRINT

SlimeM WHEN (SlimeM.HP > 0) DO
    (">> Spike Slime (M) attacks!") PRINT
    SlimeM EnemyAct Player
    Player ShowHP
END

SlimeS WHEN (SlimeS.HP > 0) DO
    (">> Acid Slime (S) attacks!") PRINT
    SlimeS EnemyAct Player
    Player ShowHP
END
("") PRINT

// ============================================================
// Turn 3: Finish them!
// ============================================================
Player StartTurn
("=== TURN 3: Player ===") PRINT
("  Energy: " + Player.Energy + "/" + Player.MaxEnergy) PRINT
("  Player HP: " + Player.HP) PRINT
("") PRINT

SlimeM WHEN (SlimeM.HP > 0) DO
    (">> Play Strike -> Spike Slime (M)") PRINT
    Player PlayCard SlimeM Strike
    SlimeM ShowHP
    SlimeM CheckDeath
    ("") PRINT
END

SlimeS WHEN (SlimeS.HP > 0) DO
    (">> Play Strike -> Acid Slime (S)") PRINT
    Player PlayCard SlimeS Strike
    SlimeS ShowHP
    SlimeS CheckDeath
    ("") PRINT
END

// ============================================================
// Battle Result
// ============================================================
("") PRINT
("========================================") PRINT
("  VICTORY!") PRINT
("========================================") PRINT
("  " + Player.Name + " | Final HP: " + Player.HP + "/" + Player.MaxHP) PRINT

// ============================================================
// Why SongLang for Game Systems?
// ============================================================
//
// Compare these approaches:
//
// C# (traditional OOP):
//   player.PlayCard(strike, enemy);
//   // Where does PlayCard live? Player class? A CardSystem?
//   // DamageEffect needs ICombatContext, IEntity...
//   // Behavior is scattered across classes.
//
// SongLang (relation-centric):
//   Player PlayCard SlimeM Strike
//   // PlayCard is a RELATIONSHIP between Caster, Target, Card
//   // DealDamage is a RELATIONSHIP between Attacker, Victim, Damage
//   // Behavior lives in the CONNECTION, not in any single object.
//
// Benefits for game design:
// 1. Code reads like design docs
//    "Player PlayCard Enemy Strike" = natural language
// 2. Behavior belongs to relationships
//    An attack isn't "Player's method" — it's the bond between attacker & victim
// 3. Easy to extend
//    Add a Poison relation, a Buff relation — no existing code changes
// 4. Query system for game state
//    ?wounded HAS HP WHERE ?wounded.HP < 10
//    ALL ?wounded HAS Status "Critical"
// ============================================================
